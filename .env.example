# REVIVE MESH Environment Configuration
# Copy this file to .env and fill in the values.

# APP SETTINGS
APP_ENV=local
CORS_ALLOWED_ORIGINS=http://localhost:3000

# DATABASE (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=revive_mesh
DB_USER=revive_user
DB_PASSWORD=revive_password
DATABASE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# KAFKA
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# INTELLIGENCE SERVICE (Python FastAPI)
INTELLIGENCE_SERVICE_HOST=localhost
INTELLIGENCE_SERVICE_PORT=8000
INTELLIGENCE_SERVICE_URL=http://${INTELLIGENCE_SERVICE_HOST}:${INTELLIGENCE_SERVICE_PORT}

# BACKEND (Spring Boot)
BACKEND_HOST=localhost
BACKEND_PORT=8080
BACKEND_API_URL=http://${BACKEND_HOST}:${BACKEND_PORT}

# LLM 
LLM_API_KEY=your_api_key_here
